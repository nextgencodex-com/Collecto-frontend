# Backend API base URL, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: shop time zone for "today" (must match the backend APP_TZ). Default Asia/Colombo.
# NEXT_PUBLIC_APP_TZ=Asia/Colombo
# Optional: pin "today" for demos. Set the backend APP_TODAY to the same date.
# NEXT_PUBLIC_DEMO_TODAY=2026-10-13
